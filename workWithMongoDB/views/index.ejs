<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3> All chats </h3>
    <form method="GET" action="/chats/new">
        <button> Create NEW CHAT</button>
    </form>
    <% for(let chat  of chats){ %>
        <div class="section">
            <div class="chat">
                <p>FROM :<i><%= chat.from %></i> </p>
                <div class="msg" >
                    <p><%= chat.msg %></p>
                    <form method="GET" action="/chats/<%= chat._id %>/edit">
                        <button>EDIT Chat</button>
                    </form>
                    <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
                        <button>DELETE Chat</button>
                    </form>
                </div>
                <p>Received By :<i><%= chat.to %></i></p>
                <hr>
                <p><%= chat.created_at.toString().split(" ")[4] %></p>
                <p><%= chat.created_at.toString().split(" ").slice(1,4).join("-") %></p>
            </div>
        </div>
    <% } %>
</body>
</html>